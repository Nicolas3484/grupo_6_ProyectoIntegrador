<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.5.1/animate.min.css">
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.1/css/font-awesome.min.css">

<%- include('dashboard.ejs') %>
<body>
  

<div class="containerr">

    <section class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">Panel Edicion Producto</h3>
      </div>
      <div class="panel-body">
        <h1 class="text-center text-danger my-4">Editar Producto</h1>

        <a href="/admin/productos" class="btn btn-primary mb-4">Volver al listado</a>
        
        <div class="card container p-4" style="width:60rem;">
          <form action="/admin/editar-producto/<%= product.id %>?_method=PUT" method="POST" class="row justify-content-between" enctype="multipart/form-data">
        
        
            <div class="mb-3 col-6">
              <label class="form-label">Titulo</label>
              <input type="text" name="titulo" class="form-control" value="<%= locals.old?.titulo || locals.old?.titulo === "" ? locals.old?.titulo : product.titulo %>">
              <p class="text-danger">
                <%= locals.errors?.titulo?.msg %>
              </p>
            </div>
        
            <div class="mb-3 col-6">
              <label class="form-label">Precio</label>
              <input type="number" name="precio" value="<%= locals.old?.precio || locals.old?.precio === "" ? locals.old?.precio : product.precio %>" class="form-control">
              <p class="text-danger">
                <%= locals.errors?.precio?.msg %>
              </p>
            </div>
            <label>Descripción</label>
            <div class="mb-3 form-floating col-6">
              
              <textarea class="form-control" name="descripcion" placeholder="Colocar la descripción del curso"><%= locals.old?.descripcion || locals.old?.descripcion === "" ? locals.old?.descripcion : product.descripcion %></textarea>
              <p class="text-danger">
                <%= locals.errors?.descripcion?.msg %>
              </p>
            </div>

        
            <hr>
            <div class="mb-3 form-check form-switch col-4">
              <!-- <input class="form-check-input" type="checkbox" id="available" name="available" checked> -->
              <label class="form-check-label" for="available">Disponible</label>
            </div>
        
            <div class="mb-3 col-8">
              <label for="image" class="form-label text-info">Seleccionar la imagen principal</label>
              <input class="form-control form-control-sm" id="image" type="file" name="imagenPrincipal"> 
              <p class="text-danger col-12">
                <%= locals.errors?.imagenPrincipal.msg %>
              </p>
            </div>
        
            <button type="submit" class="mb-3 btn btn-success col-4">Editar Producto</button>
          </form>
        
        
        </div>