<link rel="stylesheet" href="/css/header2.css">
<link rel="stylesheet" href="/css/home2.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" type="text/css" href="/css/library/glider.min.css">


<header class="main-header">
    <div class="pesho">
        <nav>
            <div class="menu-toggle" id="mobile-menu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
            <ul class="nav-list">
                <li><a href="/admin">Admin</a></li>
                <li><a href="/">Home</a></li>
                <li><a href="#">About</a></li>
            </ul>
        </nav>
    </div>
    <a class="logo-container" href="/home"><img class="logo" src="/images/icons/logo_piola.jpg" alt="Logo"></a>
    <form class="buscador" action="/buscar" method="get">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input class="input" type="text" id="search" name="buscador" placeholder="Buscar ...">
    </form>
    <% if (!locals.userLogin) { %>
        <nav class="nav-bar">
            <ul class="nav-ul">
                <li id="nav-icons">
                    <a href="">
                        <i class="fa-solid fa-heart"></i>
                    </a>
                </li>
                <div class="dropdown">
                    <button class="dropbtn"><i class="fa-solid fa-user user"></i> </button>
                    <div class="dropdown-content">
                        <a href="/registrar">Registrarse</a>
                        <a href="/iniciar">Iniciar Sesion</a>
                    </div>
                </div>
                <li id="nav-icons">
                    <a href="/carrito">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </a>
                </li>
                </ul>
                <% } else { %>
                <nav class="nav-bar">
                    <ul class="nav-ul">
                        <li id="nav-icons">
                            <a href="">
                                <i class="fa-solid fa-heart"></i>
                            </a>
                        </li>
                        <li class="nav-profile">
                            <div class="dropdown">
                                <img id="imgProfile" src ="/images/icons/elpesho.png" alt="">
                                <div id="dropdown-contento" class="dropdown-content">
                                    <a id="fuente" href="/perfil">Mi perfil</a>
                                    <a id="fuente" href="/">Cerrar sesión</a>
                                </div>
                            </div>
                        </li>
                        <a id="nombre-usuario" href="/perfil"><%= locals.userLogin.nombre%></a>                    
                        <li id="nav-icons">
                            <a href="/carrito">
                                <i class="fa-solid fa-cart-shopping"></i>
                            </a>
                        </li>
                    </ul>
                <% } %>
        </nav>
</header>
<main>
    <!-- PRODUCTOS <DESTACADOS>-->
        <section class="pag">
            <h2 class="subt">DESTACADOS</h2>
            <!-- SLIDER -->
            <div class="glider-contain productos">
                <div class="glider grupo">
                    <% products.forEach(p => { %>     
                    <div class="product-card"><a href="/producto/<%=p.id%>"><img src="/images/productos/<%=p.imagen%>" alt="producto1"></a>

                        <h2><%= p.titulo%></h2>
                        <p>Creador: <%=p.autores%></p>
                        <p class="price"><span class="old-price">7.198.400</span> $<%=p.precio%> ARS</p>
            
                    </div>
                    <% }) %>
                </div>
            </div>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.5/cdn.js"></script>
<script src="/js/functions/header.js"></script>
<script src="/js/library/glider.min.js" defer></script>
<script src="/js/configs/configGlider.js" defer></script>
