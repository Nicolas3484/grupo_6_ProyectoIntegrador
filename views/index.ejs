<!DOCTYPE html>
<html lang="es">
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"> -->
  <link rel="stylesheet" href="./css/styles.css"/>
     <!-- head -->
     <%- include("./partials/headHome") %>
<body>
    <!-- header -->
    <%- include("./partials/header2") %>
    <main class="main-home">
      <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
          <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
          <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
          <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img src="/images/banners/banner-1.webp" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
              <h5>Descubrí</h5>
              <p>Embellece tu mundo con arte auténtico.</p>
            </div>
          </div>
          <div class="carousel-item">
            <img src="/images/banners/banner-2 jpg.jpg" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
              <h5>Disfrutá</h5>
              <p>Despierta tus sentidos con un estallido de colores y creatividad.</p>
            </div>
          </div>
          <div class="carousel-item">
            <img src="/images/banners/banner-3 .jpg" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
              <h5>Explorá</h5>
              <p>Artistas famosos, arte histórico.</p>
            </div>
          </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>

      <!-- PRODUCTOS <DESTACADOS>-->
        <section class="pag">
          <h2 class="subt">DESTACADOS</h2>
          <!-- SLIDER -->
          <div class="glider-contain productos">
            <div class="glider grupo">
                <% for( let index = 0; index < producto.length; index++ ) { %>          
                <div class="contenedor-imagen"><a href="/producto/<%=producto[index].id%>"><img src="/images/productos/<%=producto[index].imagen%>" alt="producto1"></a>
                  <div class="overlay">
                    <h4><a href="/producto/<%=producto[index].id%>"><%= producto[index].titulo%></a></h4>
                    <i class="fas fa-heart"></i>
                    <div class="desc">
                      <p>Creador <%=producto[index].autores%></p>
                      <p>Precio <%=producto[index].precio%></p>
                    </div>
                  </div>
                </div>
                <% } %>
            </div>
          <!-- PRODUCTOS <R. PARA TI>-->
          <h2 class="subt">RECOMENDADOS PARA TI</h2>
          <div class="productosOfertas">
              <div class="grupo">
              <% for( let i = 0; i < producto.length; i++ ) { %>
                <a href="/producto/<%= producto[i].id%>"><img src="/images/productos/<%= producto[i].imagen %>" alt="producto1"></a>
              <% } %>
              </div>
          </div>
      </section>
  </main>
      <!-- Footer -->
      <%- include("./partials/footer2") %>
        <!-- BOOTSTRAP SCRIPT -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
        
</body>
</html>