<header class="main-header">
    <div class="container">
        <nav>
            <div class="menu-toggle" id="mobile-menu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
            <ul class="nav-list">
                <li><a href="/admin">Admin</a></li>
                <li><a href="/">Home</a></li>
                <li><a href="#">About</a></li>
            </ul>
        </nav>
    </div>
      
    <figure>
        <a href="/home"><img class="logo" src="/images/icons/logo_oscuro.ico" alt="Logo"></a>
    </figure>
  
    <form action="/buscar" method="get">
   
        <i class="fa-solid fa-magnifying-glass"></i>
        <input class="input" type="text" id="search" name="buscador" placeholder="Artista, Categoría, Pintura...">
    </form>
    <% if (!locals.userLogin) { %>
    <nav class="nav-bar">
        <ul class="nav-ul">
            <li id="nav-icons"><a href=""><i class="fa-solid fa-heart"></i></a></li>
            <div class="dropdown">
                <button class="dropbtn"><i class="fa-solid fa-user user"></i> </button>
                <div class="dropdown-content">
                  <a href="/registrar">Registrarse</a>
                  <a href="/iniciar">Iniciar Sesion</a>
                </div>
              </div>
              <li id="nav-icons"><a href="/carrito"><i class="fa-solid fa-cart-shopping"></i></a></li>
            </ul>
              <% } else { %>
                <nav class="nav-bar">
                    <ul class="nav-ul">
                        <li id="nav-icons"><a href=""><i class="fa-solid fa-heart"></i></a></li>
                        <li class="nav-profile">
                            <div class="dropdown">
                                <img src ="/images/icons/elpesho.png" alt="">
                                <div id="dropdown-contento" class="dropdown-content">
                                  <a id="fuente" href="/registrar">Mi perfil</a>
                                  <a id="fuente" href="/iniciar">Cerrar sesión</a>
                                </div>
                              </div>
                     
                        </li>
                          <a id="nombre-usuario" href="/perfil"><%= locals.userLogin.nombre%></a>
                   
                          <li id="nav-icons"><a href="/carrito"><i class="fa-solid fa-cart-shopping"></i></a></li>
                        </ul>
                     </li><% } %>
            
    </nav>
  </header>
  
    <!-- BOOTSTRAP SCRIPT -->
